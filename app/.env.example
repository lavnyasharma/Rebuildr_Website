# Copy to .env.production (or set in your host) before building.
# Public site URL (canonical, sitemap, social tags)
VITE_SITE_URL=https://your-domain.com
# Google Analytics 4 measurement ID. Leave empty to disable analytics (and the consent bar).
VITE_GA_MEASUREMENT_ID=
# Optional: POST endpoint for waitlist signups
VITE_WAITLIST_ENDPOINT=
